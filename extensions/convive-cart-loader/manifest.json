{
  "manifest_version": 3,
  "name": "CoCo · Cargador de Supermercado",
  "version": "1.3.4",
  "description": "Carga automáticamente en el supermercado que elijas la lista que CoCo comparó por ti. Tú revisas y pagas; CoCo nunca confirma la compra.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://super.lider.cl/*",
    "https://www.lider.cl/*",
    "https://lider.cl/*",
    "https://www.jumbo.cl/*",
    "https://jumbo.cl/*",
    "https://www.santaisabel.cl/*",
    "https://santaisabel.cl/*",
    "https://www.unimarc.cl/*",
    "https://unimarc.cl/*",
    "https://www.tottus.cl/*",
    "https://tottus.cl/*",
    "https://www.acuenta.cl/*",
    "https://acuenta.cl/*",
    "https://irurzun.cl/*",
    "https://www.irurzun.cl/*",
    "https://i5.walmartimages.cl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://conviveconnect.com/*",
        "https://www.conviveconnect.com/*",
        "http://localhost:3000/*",
        "http://localhost:3012/*"
      ],
      "js": [
        "convive-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://super.lider.cl/*",
        "https://www.lider.cl/*",
        "https://lider.cl/*",
        "https://www.jumbo.cl/*",
        "https://jumbo.cl/*",
        "https://www.santaisabel.cl/*",
        "https://santaisabel.cl/*",
        "https://www.unimarc.cl/*",
        "https://unimarc.cl/*",
        "https://www.tottus.cl/*",
        "https://tottus.cl/*",
        "https://www.acuenta.cl/*",
        "https://acuenta.cl/*",
        "https://irurzun.cl/*",
        "https://www.irurzun.cl/*"
      ],
      "js": [
        "store-config.js",
        "page-signals.js",
        "retailer-loader.js"
      ],
      "css": [
        "loader.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
