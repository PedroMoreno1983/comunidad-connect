# Proxy residencial que usa el contenedor vpn. Rotar la contraseña en el
# proveedor y pegarla solo en el .env del servidor, nunca en este archivo.
RESIDENTIAL_PROXY_HOST=
RESIDENTIAL_PROXY_PORT=
RESIDENTIAL_PROXY_USER=
RESIDENTIAL_PROXY_PASS=

PUBLIC_BASE_URL=https://cart.conviveconnect.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
PORT=4387
MAX_SESSIONS=3
SESSION_IDLE_SECONDS=2700
SESSION_HARD_SECONDS=5400
